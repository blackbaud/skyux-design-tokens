      "groups": [
        {
          "name": "Containers",
          "description": "Apply a container class to the element that wraps a section of content. Container classes set the background, border, and text color, and SKY UX components inside the container adjust to match.",
          "styles": [
            {
              "name": "Default container",
              "className": "sky-theme-container-default",
              "description": "The main container for content and actions on a page.",
              "properties": {
                "background-color": "var(--sky-theme-color-background-container-default)",
                "border": "var(--sky-theme-border-container-default)",
                "border-radius": "var(--sky-theme-border-radius-s)",
                "color": "var(--sky-theme-color-text-default)"
              },
              "resetContextOverrides": true
            },
            {
              "name": "Dimmed container",
              "className": "sky-theme-container-dimmed",
              "description": "A container for actions or content that is secondary or supports default containers.",
              "properties": {
                "background-color": "var(--sky-theme-color-background-container-dimmed)",
                "color": "var(--sky-theme-color-text-default)"
              },
              "resetContextOverrides": true
            },
            {
              "name": "Backdrop container",
              "className": "sky-theme-container-backdrop",
              "description": "A container behind a canvas, WYSIWYG editor, or preview.",
              "properties": {
                "background-color": "var(--sky-theme-color-background-container-backdrop)",
                "color": "var(--sky-theme-color-text-default)"
              },
              "resetContextOverrides": true
            },
            {
              "name": "Prominent container",
